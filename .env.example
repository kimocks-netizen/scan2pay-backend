# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=dev

# ── Supabase (add your keys when ready) ──────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── WinSMS (same account as PredictIQ) ───────────────────────────────────────
WINSMS_API_URL=https://api.winsms.co.za/api/rest/v1
WINSMS_API_KEY=your-winsms-api-key

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_key
PAYSTACK_PUBLIC_KEY=pk_test_your_key
PAYSTACK_WEBHOOK_SECRET=your-webhook-secret

# ── AWS ───────────────────────────────────────────────────────────────────────
ASSETS_BUCKET=scan2pay-assets-dev
AWS_REGION=af-south-1

# ── WebSocket (filled in after first deploy) ──────────────────────────────────
WEBSOCKET_ENDPOINT=https://{ws-api-id}.execute-api.af-south-1.amazonaws.com/Prod
WS_CONNECTIONS_TABLE=scan2pay-ws-connections-dev

# ── Master bypass (admin only — never share publicly) ────────────────────
MASTER_OTP=KIMO

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
